# Production settings. Copy to .env.production.local and fill in.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# Service account JSON on one line (Firebase console > Project settings > Service accounts).
FIREBASE_SERVICE_ACCOUNT_KEY=

# Protects /api/cron/* (send as "Authorization: Bearer <secret>").
CRON_SECRET=

# WhatsApp Cloud API. Without these, replies and alerts are only stored in the whatsappOutbox collection.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Customer-facing WhatsApp number for the public website (digits with country code). Leave empty to hide the button.
NEXT_PUBLIC_COMPANY_WHATSAPP=
