{
  "name": "textileflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "lint": "eslint",
    "dev:local": "firebase emulators:exec --project demo-textileflow --only auth,firestore --import=.emulator-data --export-on-exit=.emulator-data \"npm run seed && node --env-file=.env.emulator node_modules/next/dist/bin/next dev --turbopack\"",
    "emulators": "firebase emulators:start --project demo-textileflow --only auth,firestore --import=.emulator-data --export-on-exit=.emulator-data",
    "seed": "tsx --env-file=.env.emulator scripts/seed.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "predev:local": "mkdir -p .emulator-data",
    "preemulators": "mkdir -p .emulator-data",
    "create-user": "tsx --env-file=.env.local scripts/create-user.ts",
    "seed:firebase": "tsx --env-file=.env.local scripts/seed.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "firebase": "^13.0.0",
    "firebase-admin": "^13.10.0",
    "lucide-react": "^1.54.0",
    "next": "15.5.27",
    "next-themes": "^0.4.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.4",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@netlify/plugin-nextjs": "^5.16.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.27",
    "firebase-tools": "^15.33.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
