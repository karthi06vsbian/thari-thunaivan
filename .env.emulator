# Used only by "npm run dev:local" and "npm run seed" (Firebase emulators). Nothing here is secret.
# Real Firebase settings go in .env.local, which "npm run dev" reads.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-textileflow
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=localhost
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Password given to the four seeded test users (see scripts/seed.ts).
SEED_USER_PASSWORD=textile-demo-2026
CRON_SECRET=dev-cron-secret

# Stops the Admin SDK probing for Google Cloud metadata when running on the emulators.
METADATA_SERVER_DETECTION=none

# Shown as one-click demo logins on the sign-in page. Emulator only; never set this in production.
NEXT_PUBLIC_DEMO_PASSWORD=textile-demo-2026
