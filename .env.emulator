# Used only by "npm run dev:local" and "npm run seed" (Firebase emulators). Nothing here is secret.
# Real Firebase settings go in .env.local, which "npm run dev" reads.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-textileflow
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=localhost
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

CRON_SECRET=dev-cron-secret

# Stops the Admin SDK probing for Google Cloud metadata when running on the emulators.
METADATA_SERVER_DETECTION=none


# Left empty on purpose so the local demo never sends real WhatsApp messages,
# even when .env.local holds a live token.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
